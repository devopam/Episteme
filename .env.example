# Copy to .env and adjust. .env is gitignored. Real environment variables
# override values set here. src/episteme/config.py is the only reader.

# --- Filesystem roots ---
EPISTEME_DATA_ROOT=.                      # single relocatable knob; the three roots below default under it
EPISTEME_RAW_ROOT=./01_raw
EPISTEME_PROCESSED_ROOT=./02_processed
EPISTEME_CORPUS_ROOT=./03_corpus

# --- PostgreSQL (SP1-β+) ---
PGHOST=localhost
PGPORT=5433
PGDATABASE=episteme
PGUSER=episteme_app                       # pipeline runtime role
PGPASSWORD=                               # = EPISTEME_DB_PASSWORD
EPISTEME_DB_PASSWORD=                     # episteme_app's password; init_database.sh sets it
EPISTEME_SYS_ADMIN_PASSWORD=             # episteme_sys_admin's password (DDL/migration/dev role)
                                        # pg-marked tests skip if unset. Use the DDL-capable role against the
                                        # throwaway test DB — the suite drops/recreates the episteme schema.
                                        # MUST be quoted: the value has spaces and `set -a && . .env` would
                                        # otherwise split it.
TEST_PG_DSN="host=localhost port=5433 dbname=episteme_test user=episteme_sys_admin password="

# --- OpenMetadata (optional; blank = skip ingest) ---
OM_HOST=
OM_JWT=

# --- MCPg MCP server ---
# scripts/mcpg-episteme.sh (invoked by .mcp.json) sources THIS file at
# server-spawn time and builds MCPG_DATABASE_URL / MCPG_SECONDARY_DATABASE_URLS
# from EPISTEME_SYS_ADMIN_PASSWORD (above) — no connection string in git, and
# no need to export anything before `claude`. Two servers are registered:
#   mcpg       -> primary=episteme, read-only secondary=episteme_test
#   mcpg-test  -> primary=episteme_test (writable; secondaries are read-only)
MCPG_ACCESS_MODE=unrestricted            # read-only | restricted | unrestricted
MCPG_ALLOW_DDL=true                      # unrestricted-mode capability gate

# --- Audit (REQUIRED for any stage that writes audit records) ---
EPISTEME_ACTOR=                          # e.g. episteme_sys_admin for system/dev runs
EPISTEME_RUN_ID=                         # set by run_pipeline.sh per invocation; leave blank
                                        # for a standalone CLI call (it generates its own)

# --- Upstream endpoints ---
# Every <SOURCE>_BASE / _S3 / _FTP / _CATALOG default lives in
# scripts/data/_lib/sources.env (committed, one source of truth). Override any of
# them here or in the real environment; load order is sources.env -> .env -> real
# env, last wins.

# --- Database mode (SP4.1) ---
# read-only | restricted | unrestricted. Code default when unset is `restricted`
# (refuses the production database; override per command with an
# EPISTEME_DB_MODE=unrestricted prefix). `unrestricted` is a development-phase
# setting -- set it back to `restricted` at go-live.
PGDATABASE_SECONDARY=episteme_test
EPISTEME_DB_MODE=restricted
# EPISTEME_DB_TARGET=primary               # primary | secondary
