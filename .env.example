# Copy to .env and adjust. .env is gitignored. Real environment variables
# override values set here. src/episteme/config.py is the only reader.

# --- Filesystem roots ---
EPISTEME_DATA_ROOT=.                      # single relocatable knob; the three roots below default under it
EPISTEME_RAW_ROOT=./01_raw
EPISTEME_PROCESSED_ROOT=./02_processed
EPISTEME_CORPUS_ROOT=./03_corpus

# --- PostgreSQL (SP1-β+) ---
PGHOST=localhost
PGPORT=5433
PGDATABASE=episteme
PGUSER=episteme_app                       # pipeline runtime role
PGPASSWORD=                               # = EPISTEME_DB_PASSWORD
EPISTEME_DB_PASSWORD=                     # episteme_app's password; init_database.sh sets it
EPISTEME_SYS_ADMIN_PASSWORD=             # episteme_sys_admin's password (DDL/migration/dev role)
                                        # pg-marked tests skip if unset. Use the DDL-capable role against the
                                        # throwaway test DB — the suite drops/recreates the episteme schema.
                                        # MUST be quoted: the value has spaces and `set -a && . .env` would
                                        # otherwise split it.
TEST_PG_DSN="host=localhost port=5433 dbname=episteme_test user=episteme_sys_admin password="
EPISTEME_API_READER_PASSWORD=            # episteme_api_reader's password (SQL lookup API, MCPg --reader);
                                        # the operator sets the role's password to this value

# --- OpenMetadata (optional; blank = skip ingest) ---
OM_HOST=
OM_JWT=

# --- MCPg MCP server ---
# scripts/mcpg-episteme.sh (invoked by .mcp.json) sources THIS file at
# server-spawn time and builds MCPG_DATABASE_URL / MCPG_SECONDARY_DATABASE_URLS
# from EPISTEME_SYS_ADMIN_PASSWORD (above) — no connection string in git, and
# no need to export anything before `claude`. Two servers are registered:
#   mcpg       -> primary=episteme, read-only secondary=episteme_test
#   mcpg-test  -> primary=episteme_test (writable; secondaries are read-only)
MCPG_ACCESS_MODE=unrestricted            # read-only | restricted | unrestricted
MCPG_ALLOW_DDL=true                      # unrestricted-mode capability gate

# --- Audit (REQUIRED for any stage that writes audit records) ---
EPISTEME_ACTOR=                          # e.g. episteme_sys_admin for system/dev runs
EPISTEME_RUN_ID=                         # set by run_pipeline.sh per invocation; leave blank
                                        # for a standalone CLI call (it generates its own)

# --- Upstream endpoints ---
# Every <SOURCE>_BASE / _S3 / _FTP / _CATALOG default lives in
# scripts/data/_lib/sources.env (committed, one source of truth). Override any of
# them here or in the real environment; load order is sources.env -> .env -> real
# env, last wins.

# --- Database mode (SP4.1) ---
# read-only | restricted | unrestricted. Code default when unset is `restricted`
# (refuses the production database; override per command with an
# EPISTEME_DB_MODE=unrestricted prefix). `unrestricted` is a development-phase
# setting -- set it back to `restricted` at go-live.
PGDATABASE_SECONDARY=episteme_test
EPISTEME_DB_MODE=restricted
# EPISTEME_DB_TARGET=primary               # primary | secondary

# --- Throughput ---
# EPISTEME_EXTRACT_WORKERS=3              # worker processes per extract/serialize stage (default 3)

# --- EDQM Standard Terms API (reference code lists; leave blank to skip) ---
EDQM_STAPI_LOGIN=
EDQM_STAPI_SECRET_KEY=
# LOINC Download API: the LOINC account username (not the e-mail) and password.
# Put the password in single quotes ('...') when it holds $ or #.
LOINC_USERNAME=
LOINC_SECRET_KEY=

# --- Tuning values (defaults are in src/episteme/config.py; remove the # to override) ---
# EPISTEME_TEXT_NULLOUT_BATCH_ROWS=50000
# EPISTEME_TEXT_NULLOUT_BATCH_BLOCKS=4096
# EPISTEME_REPACK_LOCK_TIMEOUT_S=60
# EPISTEME_FTS_LOCK_TIMEOUT_S=0
# EPISTEME_DAILYMED_COPY_BATCH_ROWS=20000
# EPISTEME_PMC_SUBMIT_BATCH=2000
# EPISTEME_SFT_SLICE_BATCH_ROWS=2048
# EPISTEME_SFT_SLICE_ROWS_PER_PART=50000
# EPISTEME_REFERENCE_DOCS_CONNECT_TIMEOUT_S=30
# EPISTEME_REFERENCE_DOCS_READ_TIMEOUT_S=120
# EPISTEME_REFERENCE_DOCS_MAX_UNPACKED_BYTES=2147483648
# EPISTEME_REFERENCE_DOCS_MAX_WAIT_S=900
# EPISTEME_REFERENCE_DOCS_FALLBACK_THROTTLE_WAIT_S=30
# EPISTEME_EMA_CONNECT_TIMEOUT_S=30
# EPISTEME_BOOKSHELF_MAX_PACKAGE_BYTES=1073741824
# EPISTEME_APOLLO_MIN_BYTES=10485760
# SQL lookup API row caps per family, "<default>,<max>" (families: regulatory, label, trials,
# faers, literature, graph, search, code, resolve, graph_scan, search_scan). Run `python -m episteme.reference.api_settings sync` after a change.
# EPISTEME_API_LIMIT_REGULATORY=200,1000
# EPISTEME_API_LIMIT_LABEL=200,2000
# EPISTEME_API_LIMIT_TRIALS=200,1000
# EPISTEME_API_LIMIT_FAERS=500,5000
# EPISTEME_API_LIMIT_LITERATURE=50,500
# EPISTEME_API_LIMIT_GRAPH=50,500
# EPISTEME_API_LIMIT_SEARCH=20,200
# EPISTEME_API_LIMIT_CODE=1,1
# EPISTEME_API_LIMIT_RESOLVE=10,50
# graph_scan is not a row cap: graph_neighbours 'shared_mesh' skips a descriptor on more article_mesh rows.
# EPISTEME_API_LIMIT_GRAPH_SCAN=20000,20000
# search_scan is not a row cap: search_text ranks only this many index matches per partition.
# EPISTEME_API_LIMIT_SEARCH_SCAN=5000,5000
# statement_timeout of the API reader role, seconds (0 = none); `api_settings sync` sets it.
# EPISTEME_API_READER_STATEMENT_TIMEOUT_S=30
# Search log of the question_mcp server (JSON lines); default <data root>/_question_log.
# EPISTEME_QUESTION_LOG_DIR=
