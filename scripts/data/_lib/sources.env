# Episteme acquisition endpoints — single source of truth (SP3).
# Load order everywhere: this file -> .env -> real environment (last wins).
# Override any value in ./.env or the real environment; never edit a wrapper.
# Plain KEY=value only. Later SP3 tasks may append more vars here.

# --- Literature / Europe PMC ---
NCBI_FTP_HOST=ftp.ncbi.nlm.nih.gov
EBI_FTP_HOST=ftp.ebi.ac.uk
PUBMED_FTP_BASE=https://ftp.ncbi.nlm.nih.gov/pubmed
PMC_S3_BUCKET=pmc-oa-opendata
EUROPEPMC_BASE=https://www.ebi.ac.uk/europepmc/webservices/rest
EUROPEPMC_PREPRINT_BASE=https://ftp.ebi.ac.uk/pub/databases/pmc/preprints
EUROPEPMC_ABSTRACTS_BASE=https://ftp.ebi.ac.uk/pub/databases/pmc/preprint_abstracts
EUROPEPMC_MANUSCRIPT_BASE=https://ftp.ebi.ac.uk/pub/databases/pmc/manuscripts
EUROPEPMC_ID_MAPPINGS_BASE=https://ftp.ebi.ac.uk/pub/databases/pmc/DOI
EUROPEPMC_LITE_BASE=https://ftp.ebi.ac.uk/pub/databases/pmc/PMCLiteMetadata
BOOKSHELF_BASE=https://ftp.ncbi.nlm.nih.gov/pub/litarch
APOLLO_HF_REPO=FreedomIntelligence/ApolloCorpus
GUIDELINES_HF_REPO=epfl-llm/guidelines

# --- Structured databases ---
CHEMBL_BASE=https://ftp.ebi.ac.uk/pub/databases/chembl/ChEMBLdb/latest
UNIPROT_BASE=https://ftp.uniprot.org/pub/databases/uniprot/current_release/knowledgebase/complete
UNIPROT_MIRRORS="https://ftp.uniprot.org/pub/databases/uniprot/current_release/knowledgebase/complete|https://ftp.expasy.org/databases/uniprot/current_release/knowledgebase/complete|https://ftp.ebi.ac.uk/pub/databases/uniprot/current_release/knowledgebase/complete"
PUBCHEM_BASE=https://ftp.ncbi.nlm.nih.gov/pubchem
CLINVAR_BASE=https://ftp.ncbi.nlm.nih.gov/pub/clinvar
REACTOME_BASE=https://reactome.org/download/current
MESH_BASE=https://nlmpubs.nlm.nih.gov/projects/mesh
MESH_FTP_BASE=https://ftp.nlm.nih.gov/online/mesh
OBO_PURL_BASE=http://purl.obolibrary.org/obo
UCUM_ESSENCE_URL=https://raw.githubusercontent.com/ucum-org/ucum/main/ucum-essence.xml
UCUM_README_URL=https://raw.githubusercontent.com/ucum-org/ucum/main/README.md
OPENALEX_S3=s3://openalex

# --- Volatile (download-only; discovery-based, wrappers scrape an index page) ---
# DAILYMED_BASE / AACT_DOWNLOADS are the HTML resource pages the wrappers scrape
# for .zip hrefs (the batch scripts in .superpowers/.../batch-scripts/ do exactly
# this); they are hosts+paths, not file dirs.
DAILYMED_BASE=https://www.dailymed.nlm.nih.gov/dailymed
OPENFDA_CATALOG=https://api.fda.gov/download.json
AACT_DOWNLOADS=https://aact.ctti-clinicaltrials.org/downloads

# --- CDISC Biomedical Concepts (COSMoS GitHub repo; download-only) ---
COSMOS_API_BASE=https://api.github.com/repos/cdisc-org/COSMoS
COSMOS_RAW_BASE=https://raw.githubusercontent.com/cdisc-org/COSMoS
COSMOS_REPO_URL=https://github.com/cdisc-org/COSMoS

# --- CDISC USDM (DDF-RA GitHub repo; latest release's Deliverables/; download-only) ---
USDM_API_BASE=https://api.github.com/repos/cdisc-org/DDF-RA
USDM_RAW_BASE=https://raw.githubusercontent.com/cdisc-org/DDF-RA
USDM_REPO_URL=https://github.com/cdisc-org/DDF-RA

# --- CDISC Controlled Terminology (NCI EVS; <Package>/<Package>%20Terminology.txt) ---
CDISC_CT_BASE=https://evs.nci.nih.gov/ftp1/CDISC

# --- EMA open data (JSON report feeds and the Article 57 workbook; download-only) ---
# One key per feed, named in src/episteme/data/regulatory/feeds.toml. EMA reuse is
# allowed with credit; the site shows a human-verification page under automated use,
# so the stage stops on it (see download_ema.py) and downloads one file at a time.
EMA_MEDICINES_JSON=https://www.ema.europa.eu/en/documents/report/medicines-output-medicines_json-report_en.json
EMA_POST_AUTHORISATION_JSON=https://www.ema.europa.eu/en/documents/report/medicines-output-post_authorisation_json-report_en.json
EMA_ORPHAN_JSON=https://www.ema.europa.eu/en/documents/report/medicines-output-orphan_designations-json-report_en.json
EMA_PIP_JSON=https://www.ema.europa.eu/en/documents/report/medicines-output-paediatric_investigation_plans-output-json-report_en.json
EMA_PSUSA_JSON=https://www.ema.europa.eu/en/documents/report/medicines-output-periodic_safety_update_report_single_assessments-output-json-report_en.json
EMA_REFERRALS_JSON=https://www.ema.europa.eu/en/documents/report/referrals-output-json-report_en.json
EMA_DHPC_JSON=https://www.ema.europa.eu/en/documents/report/dhpc-output-json-report_en.json
EMA_SHORTAGES_JSON=https://www.ema.europa.eu/en/documents/report/shortages-output-json-report_en.json
EMA_MRL_JSON=https://www.ema.europa.eu/en/documents/report/medicines-output-maximum_residue_limits-json-report_en.json
EMA_HERBAL_JSON=https://www.ema.europa.eu/en/documents/report/medicines-output-herbal_medicines-report-output-json_en.json
EMA_OUTSIDE_EU_JSON=https://www.ema.europa.eu/en/documents/report/medicine-use-outside-eu-output-json-report_en.json
EMA_ARTICLE57_XLSX=https://www.ema.europa.eu/en/documents/other/article-57-product-data_en.xlsx
EMA_EPAR_DOCUMENTS_JSON=https://www.ema.europa.eu/en/documents/report/documents-output-epar_documents_json-report_en.json
# The only prefix an EPAR document_url may have (the feed is data: a row must not point the
# downloader elsewhere). See src/episteme/data/ema/download_epar.py.
EMA_EPAR_DOCUMENT_PREFIX=https://www.ema.europa.eu/

# --- SFT teacher model ---
# Teacher API endpoint (spec section 9.3). Override in ./.env; the API key is never stored here.
TEACHER_BASE_URL=https://api.deepseek.com/v1

# --- Reference documents (ICH, MedDRA Points to Consider, EMA guidance; download-only) ---
# ICH: node API (JSON, lists the guideline files) and the static file host that resolves
# relative file links. MedDRA: guidance API for the English taxonomy. EMA: site root; the
# document paths sit in src/episteme/data/reference_docs/ema_documents.txt (paths only).
ICH_API_BASE=https://admin.ich.org/api/v1
ICH_FILES_BASE=https://database.ich.org
MEDDRA_API_BASE=https://admin.meddra.org/api
MEDDRA_PTC_TAXONOMY=211090a2-fbb3-4567-ae18-e85b2df91adf
EMA_BASE=https://www.ema.europa.eu
